<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sweeply.Core\Sweeply.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>SweeplyForWindows</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Fluent theme (ThemeMode) is marked experimental in .NET 9. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Shared with the README: one copy of each image, in docs/. -->
    <Resource Include="..\..\docs\icon.png" Link="Assets\icon.png" />
    <Resource Include="..\..\docs\donate\*.png" Link="Assets\donate\%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="SweeplyForWindows.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
