<Window x:Class="SweeplyForWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SweeplyForWindows" Width="720" Height="480"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="SweeplyForWindows" FontSize="32" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="A small junk cleaner for Windows. In development."
                       Margin="0,8,0,0" HorizontalAlignment="Center" Opacity="0.7"/>
            <TextBlock x:Name="VersionText" Margin="0,24,0,0"
                       HorizontalAlignment="Center" Opacity="0.5"/>
        </StackPanel>
    </Grid>
</Window>
