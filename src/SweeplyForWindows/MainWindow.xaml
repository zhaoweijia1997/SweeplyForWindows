<Window x:Class="SweeplyForWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SweeplyForWindows"
        xmlns:loc="clr-namespace:SweeplyForWindows.Localization"
        xmlns:mon="clr-namespace:SweeplyForWindows.Monitor"
        xmlns:cap="clr-namespace:SweeplyForWindows.Capture"
        Title="SweeplyForWindows" Width="1000" Height="720" MinWidth="780" MinHeight="520"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding Progress}"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <local:PageVisibilityConverter x:Key="PageVisibility"/>
        <local:TextVisibilityConverter x:Key="TextVisibility"/>
        <local:FalseVisibilityConverter x:Key="FalseVisibility"/>
        <local:DimOpacityConverter x:Key="DimOpacity"/>
        <local:ColumnWidthConverter x:Key="ColumnWidth"/>
        <BooleanToVisibilityConverter x:Key="TrueVisibility"/>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A long list with its own scroll bar that draws only the lines on screen. -->
        <Style x:Key="VirtualList" TargetType="ItemsControl">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One folder or file on the Space page: tick box, name (a folder opens), what is in it, share, size. -->
        <DataTemplate x:Key="SpaceEntryRow">
            <Grid Margin="0,2,16,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center"
                          ToolTip="{Binding WhyNot}" ToolTipService.ShowOnDisabled="True"/>
                <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" Margin="0,0,8,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButton}" Command="{Binding OpenCommand}" HorizontalAlignment="Left" ToolTip="{Binding Path}"
                            Visibility="{Binding CanOpen, Converter={StaticResource TrueVisibility}}">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding CanOpen, Converter={StaticResource FalseVisibility}}"/>
                    <!-- Largest files come from all over: where each one is, small, under its name. -->
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding SubPath}" ToolTip="{Binding Path}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding SubPath, Converter={StaticResource TextVisibility}}"/>
                </StackPanel>
                <Grid Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Detail}" ToolTip="{Binding Detail}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="12" Margin="6,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                               ToolTip="{Binding IncompleteText}" Visibility="{Binding IsIncomplete, Converter={StaticResource TrueVisibility}}"/>
                </Grid>
                <Border Grid.Column="4" Width="64" Height="6" CornerRadius="3" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                </Border>
                <TextBlock Grid.Column="5" Style="{StaticResource Secondary}" FontSize="12" Text="{Binding ShareText}" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center"/>
                <Button Grid.Column="7" Style="{StaticResource LinkButton}" Command="{Binding RevealCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                        ToolTip="{Binding [clean.reveal], Source={x:Static loc:Loc.Instance}}"
                        AutomationProperties.Name="{Binding [clean.reveal], Source={x:Static loc:Loc.Instance}}">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE838;"/>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- A row of section names; the chosen one is underlined in the accent colour. -->
        <Style x:Key="SectionStrip" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Box" Background="Transparent" Padding="14,8,14,6" Margin="0,0,4,0" CornerRadius="4">
                                        <StackPanel>
                                            <ContentPresenter x:Name="Text" TextElement.FontSize="14"
                                                              TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Border x:Name="Line" Height="3" CornerRadius="1.5" Margin="0,6,0,0" Width="18" HorizontalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Text" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Setter TargetName="Text" Property="TextElement.FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A value that copies itself when clicked: looks like plain text. -->
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One network adapter: name, what it is, connected or not, then its addresses (click one to copy it). -->
        <DataTemplate x:Key="AdapterCardTemplate">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUp}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                        </Border>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Description}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Pairs}" Margin="28,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Two columns; each row only as tall as its own tallest value. -->
                                <!-- The padding is inside the width, so two always fit side by side. -->
                                <Border Padding="0,0,16,10"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ColumnWidth}, ConverterParameter=2}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Label}"/>
                                        <Button Style="{StaticResource CopyButton}" CommandParameter="{Binding Value}"
                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                ToolTip="{Binding [net.hint], Source={x:Static loc:Loc.Instance}}">
                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One card of the Monitor page's Performance tab: name and big number, a line of detail, the
             chart of the last minutes (its scale at the top left), and what each line of the chart is. -->
        <DataTemplate x:Key="MetricCardTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,12,16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{Binding Brush}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" FontSize="16"
                                       Foreground="{Binding Brush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" MinHeight="16"
                               Text="{Binding Detail}" ToolTip="{Binding Detail}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="2" Height="92" Margin="0,8,0,6">
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"/>
                        <mon:LiveChart Points="{Binding Points}" Points2="{Binding Points2}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                       WindowSeconds="{Binding WindowSeconds}" MaxGapSeconds="{Binding MaxGapSeconds}" Stroke="{Binding Brush}"
                                       GridBrush="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <TextBlock Text="{Binding ScaleText}" FontSize="11" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <WrapPanel Grid.Row="3" Orientation="Horizontal">
                        <!-- With two series: a solid swatch for the first line and a dashed one for the second. -->
                        <Rectangle Width="12" Height="2" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Visibility="{Binding Legend2, Converter={StaticResource TextVisibility}}"/>
                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Legend1}" Margin="0,0,16,0"
                                   TextWrapping="NoWrap" Typography.NumeralAlignment="Tabular"/>
                        <Line X1="0" Y1="1" X2="12" Y2="1" Stroke="{Binding Brush}" StrokeThickness="2" StrokeDashArray="1.5 1" Margin="0,0,6,0"
                              VerticalAlignment="Center" Visibility="{Binding Legend2, Converter={StaticResource TextVisibility}}"/>
                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Legend2}" TextWrapping="NoWrap"
                                   Typography.NumeralAlignment="Tabular" Visibility="{Binding Legend2, Converter={StaticResource TextVisibility}}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Margin="12,18,8,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                <Image Source="Assets/app.ico" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="SweeplyForWindows" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE774;" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding [nav.language], Source={x:Static loc:Loc.Instance}}" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="NativeName" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <ListBox SelectedIndex="{Binding PageIndex}" BorderThickness="0" Background="Transparent">
                <ListBoxItem Padding="10,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE74D;"/>
                        <TextBlock Text="{Binding [nav.clean], Source={x:Static loc:Loc.Instance}}" Margin="14,0,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xEDA2;"/>
                        <TextBlock Text="{Binding [nav.space], Source={x:Static loc:Loc.Instance}}" Margin="14,0,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE9D9;"/>
                        <TextBlock Text="{Binding [nav.monitor], Source={x:Static loc:Loc.Instance}}" Margin="14,0,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8CB;"/>
                        <TextBlock Text="{Binding [nav.capture], Source={x:Static loc:Loc.Instance}}" Margin="14,0,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/>
                        <TextBlock Text="{Binding [nav.settings], Source={x:Static loc:Loc.Instance}}" Margin="14,0,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xEB51;"/>
                        <TextBlock Text="{Binding [nav.support], Source={x:Static loc:Loc.Instance}}" Margin="14,0,0,0"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Padding="10,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE946;"/>
                        <TextBlock Text="{Binding [nav.about], Source={x:Static loc:Loc.Instance}}" Margin="14,0,0,0"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- Pages -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>

                <!-- ===== Clean up ===== -->
                <Grid Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="32,26,32,10" Visibility="{Binding IsReviewing, Converter={StaticResource FalseVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding PageTitle}"/>
                            <!-- The tagline, or the folder chosen from the folder right-click menu. -->
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Text="{Binding PageSubtitle}" ToolTip="{Binding PageSubtitle}"/>
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{Binding LeaveFolderCommand}"
                                    Visibility="{Binding IsFolderMode, Converter={StaticResource TrueVisibility}}">
                                <TextBlock Text="{Binding [clean.folder.back], Source={x:Static loc:Loc.Instance}}"/>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" MinWidth="120" Padding="16,6" Margin="16,4,0,0"
                                Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,16"
                                  Visibility="{Binding IsReviewing, Converter={StaticResource FalseVisibility}}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,4,0,8"
                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                    Visibility="{Binding StatusMessage, Converter={StaticResource TextVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="16,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding UndoLastCommand}"
                                            Visibility="{Binding CanUndoLast, Converter={StaticResource TrueVisibility}}">
                                        <TextBlock Text="{Binding [undo.button], Source={x:Static loc:Loc.Instance}}"/>
                                    </Button>
                                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,8"
                                       Text="{Binding [clean.intro], Source={x:Static loc:Loc.Instance}}"
                                       Visibility="{Binding HasScanned, Converter={StaticResource FalseVisibility}}"/>

                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Groups and cards of apps that are not on this PC are hidden. -->
                                        <StackPanel Margin="0,10,0,6" Visibility="{Binding IsShown, Converter={StaticResource TrueVisibility}}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="2,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Categories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Card}" Visibility="{Binding IsShown, Converter={StaticResource TrueVisibility}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                                                          VerticalAlignment="Top" Margin="0,1,4,0" MinWidth="0"/>
                                                                <StackPanel Grid.Column="1" Opacity="{Binding IsDimmed, Converter={StaticResource DimOpacity}}">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Description}" Margin="0,3,0,0"/>
                                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding ExcludedText}" Margin="0,3,0,0"
                                                                               Visibility="{Binding HasExcluded, Converter={StaticResource TrueVisibility}}"/>
                                                                    <Expander Header="{Binding ItemsText}" IsExpanded="{Binding IsExpanded}" Margin="-4,6,0,0"
                                                                              Visibility="{Binding HasItems, Converter={StaticResource TrueVisibility}}">
                                                                        <StackPanel>
                                                                        <ItemsControl ItemsSource="{Binding VisibleItems}" Margin="4,4,0,0">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="12,0" VerticalAlignment="Center"/>
                                                                                        <Button Grid.Column="3" Style="{StaticResource LinkButton}" Command="{Binding RevealCommand}" VerticalAlignment="Center"
                                                                                                ToolTip="{Binding [clean.reveal], Source={x:Static loc:Loc.Instance}}"
                                                                                                AutomationProperties.Name="{Binding [clean.reveal], Source={x:Static loc:Loc.Instance}}">
                                                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE838;"/>
                                                                                        </Button>
                                                                                        <Button Grid.Column="4" Style="{StaticResource LinkButton}" Command="{Binding ExcludeCommand}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                                                ToolTip="{Binding [exclude.item], Source={x:Static loc:Loc.Instance}}"
                                                                                                AutomationProperties.Name="{Binding [exclude.item], Source={x:Static loc:Loc.Instance}}">
                                                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72E;"/>
                                                                                        </Button>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <!-- Long lists: only the largest items are drawn; the rest are still cleaned. -->
                                                                        <StackPanel Margin="4,6,0,0" Visibility="{Binding HasHiddenItems, Converter={StaticResource TrueVisibility}}">
                                                                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding HiddenItemsText}"/>
                                                                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                                    Command="{Binding ShowAllCommand}">
                                                                                <TextBlock Text="{Binding [clean.showAll], Source={x:Static loc:Loc.Instance}}"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                        </StackPanel>
                                                                    </Expander>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="16,0,0,0"
                                                                           VerticalAlignment="Top" MaxWidth="260" TextWrapping="Wrap" TextAlignment="Right"
                                                                           Opacity="{Binding IsDimmed, Converter={StaticResource DimOpacity}}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="32,14"
                            Visibility="{Binding IsReviewing, Converter={StaticResource FalseVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedText}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{Binding FoundText}" Margin="20,0,0,0" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Grid Margin="0,3,0,0">
                                    <TextBlock Style="{StaticResource Secondary}" FontSize="12"
                                               Text="{Binding [clean.note], Source={x:Static loc:Loc.Instance}}"
                                               Visibility="{Binding IsBusy, Converter={StaticResource FalseVisibility}}"/>
                                    <!-- While scanning or moving: the same line shows progress, so the footer keeps its height. -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsBusy, Converter={StaticResource TrueVisibility}}">
                                        <ProgressBar Width="240" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"
                                                     IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"/>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding ProgressText}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{DynamicResource AccentButtonStyle}" Padding="18,7" MinWidth="150"
                                    Content="{Binding [clean.moveToBin], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding CleanCommand}"/>
                        </Grid>
                    </Border>

                    <!-- The list of what would be moved: the only way to start cleaning. Takes the place of the page above. -->
                    <StackPanel Margin="32,26,32,10" Visibility="{Binding IsReviewing, Converter={StaticResource TrueVisibility}}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [review.title], Source={x:Static loc:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                   Text="{Binding [review.note], Source={x:Static loc:Loc.Instance}}"/>
                    </StackPanel>
                    <!-- Can be thousands of lines: a virtualizing list with its own scroll bar draws only what is on screen. -->
                    <ItemsControl Grid.Row="1" Margin="32,0,32,8" ItemsSource="{Binding ReviewRows}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  Visibility="{Binding IsReviewing, Converter={StaticResource TrueVisibility}}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="14" Margin="2,14,0,4"
                                               Visibility="{Binding IsHeading, Converter={StaticResource TrueVisibility}}"/>
                                    <Grid Margin="8,1,20,1" Visibility="{Binding IsHeading, Converter={StaticResource FalseVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Item.IsSelected}" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Item.Path}" ToolTip="{Binding Item.Path}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Item.SizeText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="32,14"
                            Visibility="{Binding IsReviewing, Converter={StaticResource TrueVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ReviewSummary}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,0" Text="{Binding ReviewNote}"
                                           Visibility="{Binding ReviewNote, Converter={StaticResource TextVisibility}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                <Button Padding="14,7" Margin="0,0,8,0" Command="{Binding ExportReviewCommand}"
                                        Content="{Binding [review.export], Source={x:Static loc:Loc.Instance}}"/>
                                <!-- Gets keyboard focus when the list opens; Esc also presses it. The confirm button is never the default. -->
                                <Button x:Name="ReviewBackButton" IsCancel="True" Padding="18,7" MinWidth="90" Margin="0,0,8,0"
                                        Command="{Binding CancelReviewCommand}"
                                        Content="{Binding [review.back], Source={x:Static loc:Loc.Instance}}"/>
                                <Button Style="{DynamicResource AccentButtonStyle}" Padding="18,7" MinWidth="150"
                                        Command="{Binding ConfirmCleanCommand}"
                                        Content="{Binding [review.confirm], Source={x:Static loc:Loc.Instance}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== Space: what takes up the space on a drive or in a folder ===== -->
                <Grid Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
                    <Grid DataContext="{Binding Space}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="32,26,32,10">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [space.title], Source={x:Static loc:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" Text="{Binding [space.subtitle], Source={x:Static loc:Loc.Instance}}"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Text" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Padding="14,6" Margin="8,0,0,0" Command="{Binding ChooseFolderCommand}"
                                        Content="{Binding [space.chooseFolder], Source={x:Static loc:Loc.Instance}}"/>
                                <Button Grid.Column="2" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" MinWidth="110" Margin="8,0,0,0"
                                        Command="{Binding ScanCommand}" Content="{Binding ScanButtonText}"/>
                            </Grid>
                            <!-- A folder chosen instead of a whole drive. -->
                            <TextBlock Style="{StaticResource Secondary}" Margin="2,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Text="{Binding ScanTargetText}" ToolTip="{Binding ScanTargetText}"
                                       Visibility="{Binding ScanTargetText, Converter={StaticResource TextVisibility}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="32,0,32,8">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                    Visibility="{Binding StatusMessage, Converter={StaticResource TextVisibility}}">
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding [space.intro], Source={x:Static loc:Loc.Instance}}"
                                       Visibility="{Binding ShowIntro, Converter={StaticResource TrueVisibility}}"/>
                            <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource TrueVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar Width="240" IsIndeterminate="True" VerticalAlignment="Center"/>
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ProgressText}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Text="{Binding ProgressPath}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource TrueVisibility}}">
                                <TextBlock FontWeight="SemiBold" Text="{Binding SummaryText}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" Text="{Binding UnreadableText}"
                                           Visibility="{Binding UnreadableText, Converter={StaticResource TextVisibility}}"/>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" Text="{Binding UnaccountedText}"
                                           Visibility="{Binding UnaccountedText, Converter={StaticResource TextVisibility}}"/>
                            </StackPanel>
                        </StackPanel>

                        <TabControl Grid.Row="2" Margin="32,0,32,8" SelectedIndex="{Binding TabIndex}"
                                    Visibility="{Binding HasResult, Converter={StaticResource TrueVisibility}}">
                            <TabItem Header="{Binding [space.tab.folders], Source={x:Static loc:Loc.Instance}}">
                                <DockPanel Margin="0,10,0,0">
                                    <!-- Where we are: click a folder of the path to go back up to it. -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Command="{Binding UpCommand}" Margin="0,0,10,0"
                                                VerticalAlignment="Center" ToolTip="{Binding [space.up], Source={x:Static loc:Loc.Instance}}"
                                                AutomationProperties.Name="{Binding [space.up], Source={x:Static loc:Loc.Instance}}">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74A;"/>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource LinkButton}" Command="{Binding OpenCommand}">
                                                            <TextBlock Text="{Binding Name}"/>
                                                        </Button>
                                                        <TextBlock Text="  ›  " Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding IsLast, Converter={StaticResource FalseVisibility}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" FontSize="12" Margin="0,0,0,8" Text="{Binding CurrentText}"/>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Secondary}" FontSize="12" Margin="8,6,0,0" Text="{Binding MoreText}"
                                               Visibility="{Binding MoreText, Converter={StaticResource TextVisibility}}"/>
                                    <ItemsControl Style="{StaticResource VirtualList}" ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource SpaceEntryRow}"/>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="{Binding [space.tab.largest], Source={x:Static loc:Loc.Instance}}">
                                <ItemsControl Margin="0,10,0,0" Style="{StaticResource VirtualList}" ItemsSource="{Binding LargestFiles}"
                                              ItemTemplate="{StaticResource SpaceEntryRow}"/>
                            </TabItem>
                            <TabItem Header="{Binding [space.tab.kinds], Source={x:Static loc:Loc.Instance}}">
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0"
                                               Text="{Binding [space.kinds.note], Source={x:Static loc:Loc.Instance}}"/>
                                    <ItemsControl ItemsSource="{Binding Kinds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,16,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="176"/>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Width="160" Height="8" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="{DynamicResource CardStrokeColorDefaultBrush}">
                                                        <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="4"
                                                                Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Secondary}" FontSize="12" Text="{Binding ShareText}"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Style="{StaticResource Secondary}" FontSize="12" Text="{Binding CountText}"
                                                               Margin="16,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </TabItem>
                        </TabControl>

                        <Border Grid.Row="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="32,14"
                                Visibility="{Binding HasResult, Converter={StaticResource TrueVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedText}" FontWeight="SemiBold" FontSize="15"/>
                                    <Grid Margin="0,3,0,0">
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="12"
                                                   Text="{Binding [space.note], Source={x:Static loc:Loc.Instance}}"
                                                   Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FalseVisibility}}"/>
                                        <!-- While moving: the same line shows progress, so the footer keeps its height. -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TrueVisibility}}">
                                            <ProgressBar Width="240" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                                         Value="{Binding DataContext.Progress, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                                       Text="{Binding DataContext.ProgressText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{DynamicResource AccentButtonStyle}" Padding="18,7" MinWidth="150"
                                        Content="{Binding [clean.moveToBin], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding MoveCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Monitor: what this PC is doing right now ===== -->
                <Grid Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=2}">
                    <Grid DataContext="{Binding Monitor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="32,26,32,10">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [monitor.title], Source={x:Static loc:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" Text="{Binding [monitor.subtitle], Source={x:Static loc:Loc.Instance}}"/>
                        </StackPanel>
                        <!-- The four parts of the page: a strip of names (as wide as the names), the chosen one underlined.
                             A TabControl's headers are wide in this theme and wrapped onto a second row. -->
                        <ListBox Grid.Row="1" Margin="32,0,32,0" SelectedIndex="{Binding TabIndex}" Style="{StaticResource SectionStrip}">
                            <ListBoxItem Content="{Binding [monitor.tab.performance], Source={x:Static loc:Loc.Instance}}"/>
                            <ListBoxItem Content="{Binding [monitor.tab.hardware], Source={x:Static loc:Loc.Instance}}"/>
                            <ListBoxItem Content="{Binding [monitor.tab.network], Source={x:Static loc:Loc.Instance}}"/>
                            <ListBoxItem Content="{Binding [monitor.tab.tools], Source={x:Static loc:Loc.Instance}}"/>
                            <ListBoxItem Content="{Binding [monitor.tab.connections], Source={x:Static loc:Loc.Instance}}"/>
                        </ListBox>
                        <Grid Grid.Row="2" Margin="32,0,32,12">
                            <Grid Visibility="{Binding TabIndex, Converter={StaticResource PageVisibility}, ConverterParameter=0}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource MetricCardTemplate}" Margin="0,0,-10,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <Grid Visibility="{Binding TabIndex, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                    <StackPanel DataContext="{Binding Hardware}" Margin="0,0,10,8">
                                        <!-- Temperatures: each part now, with the last minutes as a small chart -->
                                        <TextBlock Text="{Binding [hw.section.temps], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="2,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Temperatures}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}" Padding="16,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="96"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" FontSize="16"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding RangeText}" TextWrapping="NoWrap"/>
                                                            </StackPanel>
                                                            <Grid Grid.Column="2" Height="34" VerticalAlignment="Center">
                                                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"/>
                                                                <mon:LiveChart Points="{Binding Points}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                               WindowSeconds="{Binding WindowSeconds}" MaxGapSeconds="25" Stroke="{Binding Brush}"/>
                                                            </Grid>
                                                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ValueText}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Brush}"
                                                                           HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                                <TextBlock Style="{StaticResource Secondary}" FontSize="11" Text="{Binding LimitText}" HorizontalAlignment="Right"
                                                                           TextWrapping="NoWrap" Visibility="{Binding LimitText, Converter={StaticResource TextVisibility}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource Card}" Visibility="{Binding NoTemperatures, Converter={StaticResource TrueVisibility}}">
                                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding [monitor.temp.none], Source={x:Static loc:Loc.Instance}}"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,2,0,0"
                                                   Text="{Binding [hw.temps.note], Source={x:Static loc:Loc.Instance}}"/>

                                        <!-- NVMe drives' own health log -->
                                        <TextBlock Text="{Binding [hw.section.health], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="2,22,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Drives}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" MaxWidth="360"/>
                                                                </Border>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEDA2;" FontSize="16" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <ItemsControl ItemsSource="{Binding Pairs}" Margin="28,12,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Columns="3"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,12,10">
                                                                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Label}"/>
                                                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource Card}" Visibility="{Binding NoDriveHealth, Converter={StaticResource TrueVisibility}}">
                                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding [hw.health.none], Source={x:Static loc:Loc.Instance}}"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,2,0,0"
                                                   Text="{Binding [hw.health.note], Source={x:Static loc:Loc.Instance}}"/>

                                        <!-- What the PC is made of -->
                                        <DockPanel Margin="2,22,0,8">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding CopyConfigurationCommand}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [hw.copy], Source={x:Static loc:Loc.Instance}}"/>
                                            </Button>
                                            <TextBlock Text="{Binding [hw.section.config], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                        </DockPanel>
                                        <Border Style="{StaticResource Card}">
                                            <ItemsControl ItemsSource="{Binding Configuration}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Label}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid Visibility="{Binding TabIndex, Converter={StaticResource PageVisibility}, ConverterParameter=2}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                    <StackPanel DataContext="{Binding NetworkInfo}" Margin="0,0,10,8">
                                        <!-- The hint, or what was just copied: one line that is always there, so nothing jumps. -->
                                        <Grid Margin="2,0,0,8">
                                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding [net.hint], Source={x:Static loc:Loc.Instance}}"
                                                       Visibility="{Binding CopiedText, Converter={StaticResource TextVisibility}, ConverterParameter=invert}"/>
                                            <TextBlock FontSize="12" Text="{Binding CopiedText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Adapters}" ItemTemplate="{StaticResource AdapterCardTemplate}"/>
                                        <Expander Header="{Binding OthersHeader}" Margin="-4,6,0,0"
                                                  Visibility="{Binding HasOthers, Converter={StaticResource TrueVisibility}}">
                                            <ItemsControl ItemsSource="{Binding OtherAdapters}" ItemTemplate="{StaticResource AdapterCardTemplate}" Margin="4,8,0,0"/>
                                        </Expander>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,10,0,0"
                                                   Text="{Binding [net.note], Source={x:Static loc:Loc.Instance}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Grid Visibility="{Binding TabIndex, Converter={StaticResource PageVisibility}, ConverterParameter=3}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                    <StackPanel DataContext="{Binding Tools}" Margin="0,0,10,8">
                                        <!-- Ping: once a second until stopped -->
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel DataContext="{Binding Ping}">
                                                <TextBlock Text="{Binding [tools.ping.title], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" Text="{Binding [tools.ping.desc], Source={x:Static loc:Loc.Instance}}"/>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="PingTarget" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                                                             VerticalContentAlignment="Center" AutomationProperties.Name="{Binding [tools.targetHint], Source={x:Static loc:Loc.Instance}}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Enter" Command="{Binding StartStopCommand}"/>
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <TextBlock Style="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                               Text="{Binding [tools.targetHint], Source={x:Static loc:Loc.Instance}}"
                                                               Visibility="{Binding Text, ElementName=PingTarget, Converter={StaticResource TextVisibility}, ConverterParameter=invert}"/>
                                                    <Button Grid.Column="1" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Padding="16,6" Margin="8,0,0,0"
                                                            Command="{Binding StartStopCommand}" Content="{Binding ButtonText}"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,6,0,0" Text="{Binding StatusText}"
                                                           Visibility="{Binding StatusText, Converter={StaticResource TextVisibility}}"/>
                                                <WrapPanel Margin="2,10,0,0">
                                                    <TextBlock Text="{Binding StatsText}" FontWeight="SemiBold" Margin="0,0,20,0" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding TimesText}" Typography.NumeralAlignment="Tabular"/>
                                                </WrapPanel>
                                                <Grid Height="80" Margin="0,8,0,6">
                                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"/>
                                                    <mon:LiveChart Points="{Binding Points}" Maximum="{Binding Maximum}" WindowSeconds="{Binding WindowSeconds}"
                                                                   MaxGapSeconds="2.5" Stroke="{Binding Brush}" GridBrush="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                                    <TextBlock Text="{Binding ScaleText}" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Top"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding}" FontFamily="Cascadia Mono, Consolas"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Trace route: every router on the way -->
                                        <Border Style="{StaticResource Card}" Margin="0,8,0,4">
                                            <StackPanel DataContext="{Binding Trace}">
                                                <TextBlock Text="{Binding [tools.trace.title], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" Text="{Binding [tools.trace.desc], Source={x:Static loc:Loc.Instance}}"/>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TraceTarget" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                                                             VerticalContentAlignment="Center" AutomationProperties.Name="{Binding [tools.targetHint], Source={x:Static loc:Loc.Instance}}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Enter" Command="{Binding StartStopCommand}"/>
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <TextBlock Style="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                               Text="{Binding [tools.targetHint], Source={x:Static loc:Loc.Instance}}"
                                                               Visibility="{Binding Text, ElementName=TraceTarget, Converter={StaticResource TextVisibility}, ConverterParameter=invert}"/>
                                                    <Button Grid.Column="1" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Padding="16,6" Margin="8,0,0,0"
                                                            Command="{Binding StartStopCommand}" Content="{Binding ButtonText}"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,6,0,0" Text="{Binding StatusText}" TextWrapping="Wrap"
                                                           Visibility="{Binding StatusText, Converter={StaticResource TextVisibility}}"/>
                                                <ItemsControl ItemsSource="{Binding Hops}" Margin="2,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36"/>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="90"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Number}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas"/>
                                                                <TextBlock Grid.Column="2" Style="{StaticResource Secondary}" Text="{Binding Name}" TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding TimeText}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <!-- Network scan: the devices on one adapter's network -->
                                        <Border Style="{StaticResource Card}" Margin="0,4,0,4">
                                            <StackPanel DataContext="{Binding Scan}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding CopyCommand}" VerticalAlignment="Center"
                                                            Visibility="{Binding HasDevices, Converter={StaticResource TrueVisibility}}">
                                                        <TextBlock Text="{Binding [tools.scan.copy], Source={x:Static loc:Loc.Instance}}"/>
                                                    </Button>
                                                    <TextBlock Text="{Binding [tools.scan.title], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" Text="{Binding [tools.scan.desc], Source={x:Static loc:Loc.Instance}}"/>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Text"
                                                              IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch"
                                                              AutomationProperties.Name="{Binding [tools.scan.title], Source={x:Static loc:Loc.Instance}}"/>
                                                    <Button Grid.Column="1" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Padding="16,6" Margin="8,0,0,0"
                                                            Command="{Binding StartStopCommand}" Content="{Binding ButtonText}"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,6,0,0" Text="{Binding RangeText}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="2,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource TrueVisibility}}">
                                                    <ProgressBar Width="240" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
                                                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ProgressText}"/>
                                                </StackPanel>
                                                <TextBlock FontWeight="SemiBold" Margin="2,8,0,0" Text="{Binding StatusText}" TextWrapping="Wrap"
                                                           Visibility="{Binding StatusText, Converter={StaticResource TextVisibility}}"/>
                                                <ItemsControl ItemsSource="{Binding Devices}" Margin="2,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="130"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="160"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                                               Visibility="{Binding Name, Converter={StaticResource TextVisibility}}"/>
                                                                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Note}" TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" Visibility="{Binding Note, Converter={StaticResource TextVisibility}}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Style="{StaticResource Secondary}" Text="{Binding Mac}" FontFamily="Cascadia Mono, Consolas"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding TimeText}" TextAlignment="Right" VerticalAlignment="Center"
                                                                           Typography.NumeralAlignment="Tabular"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,6,0,0"
                                                   Text="{Binding [tools.note], Source={x:Static loc:Loc.Instance}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Connections: which program talks to where (like TCPView) -->
                            <Grid Visibility="{Binding TabIndex, Converter={StaticResource PageVisibility}, ConverterParameter=4}">
                                <DockPanel DataContext="{Binding Connections}" Margin="0,12,0,0">
                                    <StackPanel DockPanel.Dock="Top">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ConnectionFilter" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="{Binding [conn.filterHint], Source={x:Static loc:Loc.Instance}}"/>
                                            <TextBlock Style="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Text="{Binding [conn.filterHint], Source={x:Static loc:Loc.Instance}}"
                                                       Visibility="{Binding Text, ElementName=ConnectionFilter, Converter={StaticResource TextVisibility}, ConverterParameter=invert}"/>
                                            <Button Grid.Column="1" Padding="14,6" Margin="8,0,0,0" Command="{Binding ClearFilterCommand}"
                                                    Visibility="{Binding HasFilter, Converter={StaticResource TrueVisibility}}"
                                                    Content="{Binding [conn.clearFilter], Source={x:Static loc:Loc.Instance}}"/>
                                        </Grid>
                                        <WrapPanel Margin="0,8,0,0">
                                            <CheckBox IsChecked="{Binding HideLoopback}" Margin="0,0,20,0" Content="{Binding [conn.hideLoopback], Source={x:Static loc:Loc.Instance}}"/>
                                            <CheckBox IsChecked="{Binding ShowAll}" Margin="0,0,20,0" Content="{Binding [conn.showAll], Source={x:Static loc:Loc.Instance}}"/>
                                            <CheckBox IsChecked="{Binding LookUpNames}" Content="{Binding [conn.lookUpNames], Source={x:Static loc:Loc.Instance}}"/>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="2,8,0,6" Text="{Binding SummaryText}"/>
                                        <!-- Column headings; click one to sort by it -->
                                        <Grid Margin="8,0,16,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="176"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="124"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource LinkButton}" Command="{Binding SortCommand}" CommandParameter="Program" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding [conn.col.program], Source={x:Static loc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" FontSize="12" FontWeight="SemiBold" Text="{Binding [conn.col.protocol], Source={x:Static loc:Loc.Instance}}"/>
                                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Command="{Binding SortCommand}" CommandParameter="Local" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding [conn.col.local], Source={x:Static loc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource LinkButton}" Command="{Binding SortCommand}" CommandParameter="Remote" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding [conn.col.remote], Source={x:Static loc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Grid.Column="4" Style="{StaticResource LinkButton}" Command="{Binding SortCommand}" CommandParameter="State" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding [conn.col.state], Source={x:Static loc:Loc.Instance}}" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Secondary}" FontSize="12" Margin="2,8,0,0"
                                               Text="{Binding [conn.note], Source={x:Static loc:Loc.Instance}}"/>
                                    <ItemsControl Style="{StaticResource VirtualList}" ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,3" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="New">
                                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{Binding [conn.copy], Source={x:Static loc:Loc.Instance}}"
                                                                      Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="{Binding [conn.copyRemote], Source={x:Static loc:Loc.Instance}}"
                                                                      Command="{Binding PlacementTarget.Tag.CopyRemoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="{Binding [conn.reveal], Source={x:Static loc:Loc.Instance}}"
                                                                      Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="176"/>
                                                            <ColumnDefinition Width="220"/>
                                                            <ColumnDefinition Width="124"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ProgramTip}" Margin="0,0,8,0">
                                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                                                        Command="{Binding DataContext.FilterProgramCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding ProgramName}">
                                                                    <TextBlock Text="{Binding ProgramName}" TextTrimming="CharacterEllipsis"/>
                                                                </Button>
                                                                <TextBlock Style="{StaticResource Secondary}" FontSize="11" Text="{Binding ServicesText}" TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" Visibility="{Binding ServicesText, Converter={StaticResource TextVisibility}}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding ProtocolText}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding LocalText}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalText}"/>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding RemoteText}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding RemoteText}"/>
                                                            <TextBlock Style="{StaticResource Secondary}" FontSize="11" Text="{Binding RemoteNote}" TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RemoteNote}"
                                                                       Visibility="{Binding RemoteNote, Converter={StaticResource TextVisibility}}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="4" Text="{Binding StateText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== Capture: packets, as Wireshark shows them ===== -->
                <Grid Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=3}">
                    <Grid x:Name="CapturePage" DataContext="{Binding Capture}" AllowDrop="True" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5*" MinHeight="80"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4*" MinHeight="60"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*" MinHeight="60"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="32,26,32,8">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [cap.title], Source={x:Static loc:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" Text="{Binding [cap.subtitle], Source={x:Static loc:Loc.Instance}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="32,0,32,8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Padding="14,6" Command="{Binding OpenCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8E5;" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding [cap.open], Source={x:Static loc:Loc.Instance}}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="14,6" Margin="8,0,0,0" Command="{Binding SaveCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74E;" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding [cap.save], Source={x:Static loc:Loc.Instance}}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding FileName}" Margin="16,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <TextBlock FontSize="12" Margin="2,6,0,0" Text="{Binding Note}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding Note, Converter={StaticResource TextVisibility}}"/>
                        </StackPanel>

                        <!-- Nothing open yet -->
                        <Border Grid.Row="2" Grid.RowSpan="5" Margin="32,8,32,16" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="20"
                                Visibility="{Binding HasPackets, Converter={StaticResource FalseVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding [cap.empty.title], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" Text="{Binding [cap.empty.body], Source={x:Static loc:Loc.Instance}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding IsLoading, Converter={StaticResource TrueVisibility}}">
                                    <ProgressBar Width="200" IsIndeterminate="True" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="12,0,0,0" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- The packet list -->
                        <ListView x:Name="PacketList" Grid.Row="2" Margin="32,0,32,0" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Item" ScrollViewer.IsDeferredScrollingEnabled="False"
                                  FontSize="12.5" Typography.NumeralAlignment="Tabular" SelectionMode="Single"
                                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                  Visibility="{Binding HasPackets, Converter={StaticResource TrueVisibility}}">
                            <!-- This theme's list template has no column headers: the GridView one, with the theme's colours. -->
                            <ListView.Template>
                                <ControlTemplate TargetType="ListView">
                                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                                        <ScrollViewer Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}" Focusable="False"
                                                      CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="{Binding Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <!-- Cells in the GridView's columns (this theme's row template doesn't line them up). -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" MinHeight="22">
                                                    <Grid>
                                                        <Border x:Name="Mark" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                                                        <Border x:Name="Edge" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="0" />
                                                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"
                                                                              VerticalAlignment="Center" Margin="0,1"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Mark" Property="Opacity" Value="0.12"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Mark" Property="Opacity" Value="0.35"/>
                                                        <Setter TargetName="Edge" Property="BorderThickness" Value="0,1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <!-- The menu opens outside the list's tree: the page's view model travels in Tag. -->
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding [cap.copyRow], Source={x:Static loc:Loc.Instance}}"
                                                          Command="{Binding PlacementTarget.Tag.CopyRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="{Binding [cap.copyBytes], Source={x:Static loc:Loc.Instance}}"
                                                          Command="{Binding PlacementTarget.Tag.CopyBytesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="{Binding [cap.col.number], Source={x:Static loc:Loc.Instance}}" Width="64" DisplayMemberBinding="{Binding Number}"/>
                                    <GridViewColumn Header="{Binding [cap.col.time], Source={x:Static loc:Loc.Instance}}" Width="92" DisplayMemberBinding="{Binding Time}"/>
                                    <GridViewColumn Header="{Binding [cap.col.program], Source={x:Static loc:Loc.Instance}}" Width="110" DisplayMemberBinding="{Binding Program}"/>
                                    <GridViewColumn Header="{Binding [cap.col.source], Source={x:Static loc:Loc.Instance}}" Width="140" DisplayMemberBinding="{Binding Source}"/>
                                    <GridViewColumn Header="{Binding [cap.col.destination], Source={x:Static loc:Loc.Instance}}" Width="140" DisplayMemberBinding="{Binding Destination}"/>
                                    <GridViewColumn Header="{Binding [cap.col.protocol], Source={x:Static loc:Loc.Instance}}" Width="84" DisplayMemberBinding="{Binding Protocol}"/>
                                    <GridViewColumn Header="{Binding [cap.col.length], Source={x:Static loc:Loc.Instance}}" Width="62" DisplayMemberBinding="{Binding Length}"/>
                                    <GridViewColumn Header="{Binding [cap.col.info], Source={x:Static loc:Loc.Instance}}" Width="640" DisplayMemberBinding="{Binding Info}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <GridSplitter Grid.Row="3" Height="7" HorizontalAlignment="Stretch" Margin="32,0" Background="Transparent" ResizeBehavior="PreviousAndNext"
                                      Visibility="{Binding HasPackets, Converter={StaticResource TrueVisibility}}"/>

                        <!-- The selected packet's details -->
                        <TreeView x:Name="PacketDetails" Grid.Row="4" Margin="32,0,32,0" ItemsSource="{Binding Details}" FontSize="12.5"
                                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  Visibility="{Binding HasPackets, Converter={StaticResource TrueVisibility}}">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding [cap.copyNode], Source={x:Static loc:Loc.Instance}}" Command="{Binding CopyNodeCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding [cap.expandAll], Source={x:Static loc:Loc.Instance}}" Command="{Binding ExpandAllCommand}"/>
                                    <MenuItem Header="{Binding [cap.collapseAll], Source={x:Static loc:Loc.Instance}}" Command="{Binding CollapseAllCommand}"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="2,1"/>
                                    <Setter Property="MinHeight" Value="22"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <GridSplitter Grid.Row="5" Height="7" HorizontalAlignment="Stretch" Margin="32,0" Background="Transparent" ResizeBehavior="PreviousAndNext"
                                      Visibility="{Binding HasPackets, Converter={StaticResource TrueVisibility}}"/>

                        <!-- The selected packet's bytes -->
                        <Border Grid.Row="6" Margin="32,0,32,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="0,4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                Visibility="{Binding HasPackets, Converter={StaticResource TrueVisibility}}">
                            <cap:HexView Bytes="{Binding Bytes}" HighlightStart="{Binding HighlightStart}" HighlightLength="{Binding HighlightLength}"
                                         ByteClickedCommand="{Binding ByteClickedCommand}" HorizontalAlignment="Left"/>
                        </Border>

                        <!-- How many packets; the note on protocol names -->
                        <Border Grid.Row="7" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="32,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding [cap.englishNote], Source={x:Static loc:Loc.Instance}}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Settings ===== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,24"
                              Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=4}">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [settings.title], Source={x:Static loc:Loc.Instance}}"/>

                        <!-- Past cleans, each can be undone while its items are still in the Recycle Bin. -->
                        <TextBlock Text="{Binding [history.section], Source={x:Static loc:Loc.Instance}}"
                                   FontWeight="SemiBold" FontSize="14" Margin="2,22,0,2"/>
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,8"
                                   Text="{Binding [history.desc], Source={x:Static loc:Loc.Instance}}"/>
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasHistory, Converter={StaticResource FalseVisibility}}">
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding [history.empty], Source={x:Static loc:Loc.Instance}}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding HistoryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding StateText}"
                                                       Margin="12,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Padding="14,5" Command="{Binding UndoCommand}"
                                                    Visibility="{Binding CanUndo, Converter={StaticResource TrueVisibility}}"
                                                    Content="{Binding [history.undo], Source={x:Static loc:Loc.Instance}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,4,0,0" Text="{Binding HistoryNote}"
                                   Visibility="{Binding HistoryNote, Converter={StaticResource TextVisibility}}"/>

                        <!-- Folders and files that are never offered for cleaning. -->
                        <TextBlock Text="{Binding [exclude.section], Source={x:Static loc:Loc.Instance}}"
                                   FontWeight="SemiBold" FontSize="14" Margin="2,22,0,2"/>
                        <TextBlock Style="{StaticResource Secondary}" Margin="2,0,0,8"
                                   Text="{Binding [exclude.desc], Source={x:Static loc:Loc.Instance}}"/>
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasExclusions, Converter={StaticResource FalseVisibility}}">
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding [exclude.empty], Source={x:Static loc:Loc.Instance}}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ExcludedPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72E;" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Padding="14,5" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding [exclude.remove], Source={x:Static loc:Loc.Instance}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button HorizontalAlignment="Left" Padding="14,6" Margin="0,4,0,0" Command="{Binding AddExclusionCommand}"
                                Content="{Binding [exclude.add], Source={x:Static loc:Loc.Instance}}"/>

                        <TextBlock Text="{Binding [settings.section.background], Source={x:Static loc:Loc.Instance}}"
                                   FontWeight="SemiBold" FontSize="14" Margin="2,22,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <CheckBox IsChecked="{Binding StartWithWindows}" VerticalContentAlignment="Top">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding [settings.startWithWindows], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                               Text="{Binding [settings.startWithWindows.desc], Source={x:Static loc:Loc.Instance}}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <CheckBox IsChecked="{Binding CloseToTray}" VerticalContentAlignment="Top">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding [settings.closeToTray], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                               Text="{Binding [settings.closeToTray.desc], Source={x:Static loc:Loc.Instance}}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [settings.reminder], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                               Text="{Binding [settings.reminder.desc], Source={x:Static loc:Loc.Instance}}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="200" Margin="16,0,0,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding ReminderOptions}" DisplayMemberPath="Name"
                                          SelectedValuePath="Value" SelectedValue="{Binding SelectedReminder}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <CheckBox IsChecked="{Binding AutoCleanDaily}" VerticalContentAlignment="Top">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding [settings.autoClean], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                               Text="{Binding [settings.autoClean.desc], Source={x:Static loc:Loc.Instance}}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock Text="{Binding [settings.section.explorer], Source={x:Static loc:Loc.Instance}}"
                                   FontWeight="SemiBold" FontSize="14" Margin="2,22,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <CheckBox IsChecked="{Binding AddToFolderMenu}" VerticalContentAlignment="Top">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding [settings.folderMenu], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                               Text="{Binding [settings.folderMenu.desc], Source={x:Static loc:Loc.Instance}}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock Text="{Binding [settings.section.monitor], Source={x:Static loc:Loc.Instance}}"
                                   FontWeight="SemiBold" FontSize="14" Margin="2,22,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [settings.trayDisplay], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                               Text="{Binding [settings.trayDisplay.desc], Source={x:Static loc:Loc.Instance}}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="200" Margin="16,0,0,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding TrayDisplayOptions}" DisplayMemberPath="Name"
                                          SelectedValuePath="Value" SelectedValue="{Binding SelectedTrayDisplay}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <CheckBox IsChecked="{Binding TrayToolTipStats}" VerticalContentAlignment="Top">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding [settings.trayToolTip], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                               Text="{Binding [settings.trayToolTip.desc], Source={x:Static loc:Loc.Instance}}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <CheckBox IsChecked="{Binding ShowMonitorBar}" VerticalContentAlignment="Top">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding [settings.monitorBar], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0"
                                               Text="{Binding [settings.monitorBar.desc], Source={x:Static loc:Loc.Instance}}"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Support ===== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,24"
                              Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=5}">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [support.title], Source={x:Static loc:Loc.Instance}}"/>
                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="14"
                                   Text="{Binding [support.body1], Source={x:Static loc:Loc.Instance}}"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14"
                                   Text="{Binding [support.body2], Source={x:Static loc:Loc.Instance}}"/>
                        <UniformGrid Columns="3" Margin="0,20,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16">
                                <StackPanel>
                                    <Image Source="/Assets/donate/wechat.png" Height="210" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding [support.wechat], Source={x:Static loc:Loc.Instance}}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0" Padding="16">
                                <StackPanel>
                                    <Image Source="/Assets/donate/alipay.png" Height="210" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding [support.alipay], Source={x:Static loc:Loc.Instance}}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="16">
                                <StackPanel>
                                    <Image Source="/Assets/donate/paypal.png" Height="210" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding [support.paypal], Source={x:Static loc:Loc.Instance}}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,20,0,0" FontSize="14"
                                   Text="{Binding [support.other], Source={x:Static loc:Loc.Instance}}"/>
                        <Button HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,6"
                                Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/zhaoweijia1997/SweeplyForWindows">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE734;" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [support.star], Source={x:Static loc:Loc.Instance}}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== About ===== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,24"
                              Visibility="{Binding PageIndex, Converter={StaticResource PageVisibility}, ConverterParameter=6}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [about.title], Source={x:Static loc:Loc.Instance}}"/>
                        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="/Assets/icon.png" Width="72" Height="72" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="SweeplyForWindows" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding VersionText}" Margin="0,2,0,0"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding [about.tagline], Source={x:Static loc:Loc.Instance}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{Binding [about.privacy], Source={x:Static loc:Loc.Instance}}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding [about.license], Source={x:Static loc:Loc.Instance}}"/>
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" Text="{Binding [about.translation], Source={x:Static loc:Loc.Instance}}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/zhaoweijia1997/SweeplyForWindows">
                                    <TextBlock Text="{Binding [about.source], Source={x:Static loc:Loc.Instance}}"/>
                                </Button>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/zhaoweijia1997/SweeplyForWindows/issues">
                                    <TextBlock Text="{Binding [about.issues], Source={x:Static loc:Loc.Instance}}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
