<Window x:Class="SweeplyForWindows.Capture.FollowStreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SweeplyForWindows.Localization"
        xmlns:local="clr-namespace:SweeplyForWindows"
        Title="{Binding Title}" Width="980" Height="680" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:TextVisibilityConverter x:Key="TextVisibility"/>
        <BooleanToVisibilityConverter x:Key="TrueVisibility"/>
    </Window.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Who talked: A in its colour, B in its colour, and how much -->
        <StackPanel>
            <WrapPanel>
                <Border Background="#2CE03C3C" CornerRadius="3" Padding="8,2" Margin="0,0,8,4">
                    <TextBlock Text="{Binding EndA}" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                </Border>
                <TextBlock Text="⇄" Margin="0,2,8,4" VerticalAlignment="Center"/>
                <Border Background="#2C3C6CE0" CornerRadius="3" Padding="8,2" Margin="0,0,8,4">
                    <TextBlock Text="{Binding EndB}" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                </Border>
            </WrapPanel>
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{Binding [cap.follow.encrypted], Source={x:Static loc:Loc.Instance}}"
                       Visibility="{Binding IsEncrypted, Converter={StaticResource TrueVisibility}}"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Padding="12,5" Margin="8,0,0,0" Command="{Binding FilterCommand}"
                        Content="{Binding [cap.filter.conversation], Source={x:Static loc:Loc.Instance}}"/>
                <Button Padding="12,5" Margin="8,0,0,0" Command="{Binding CopyCommand}"
                        Content="{Binding [cap.follow.copy], Source={x:Static loc:Loc.Instance}}"/>
                <Button Padding="12,5" Margin="8,0,0,0" Command="{Binding SaveCommand}"
                        Content="{Binding [cap.follow.save], Source={x:Static loc:Loc.Instance}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="FollowDirection" MinWidth="200" MaxWidth="360" ItemsSource="{Binding DirectionChoices}" SelectedIndex="{Binding Direction}"
                          AutomationProperties.Name="{Binding [cap.follow.direction], Source={x:Static loc:Loc.Instance}}"/>
                <ComboBox x:Name="FollowShowAs" MinWidth="130" Margin="8,0,0,0" ItemsSource="{Binding ShowAsChoices}" SelectedIndex="{Binding ShowAs}"
                          AutomationProperties.Name="{Binding [cap.follow.showAs], Source={x:Static loc:Loc.Instance}}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="2" Margin="0,0,0,6" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding SaveError}" TextWrapping="Wrap"
                   Visibility="{Binding SaveError, Converter={StaticResource TextVisibility}}"/>

        <!-- The conversation, a line at a time; only the lines on screen are drawn -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <ListBox x:Name="FollowLines" ItemsSource="{Binding Lines}" BorderThickness="0" Background="Transparent"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                     AutomationProperties.Name="{Binding Title}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Background}" Padding="8,0">
                            <TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                <Setter Property="FontStyle" Value="Italic"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Text="{Binding [cap.follow.hint], Source={x:Static loc:Loc.Instance}}"/>
    </Grid>
</Window>
